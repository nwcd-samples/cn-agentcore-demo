# 复制为 .env 后填写。.env 已在 .gitignore 中,不要提交。

# ---- AWS ----
# 换成你自己的 profile 名(~/.aws/credentials 里的 section 名)
AWS_PROFILE=default
AWS_REGION=cn-northwest-1

# 所有资源名的统一前缀
PROJECT=agentcore-cn

# ---- DeepSeek ----
# 只在跑 scripts/setup_identity.py 时用于写入 AgentCore Identity 的
# API Key Credential Provider。Agent 运行时从 Identity 现取,不读这个变量。
# 本地直接调试 Agent 时也可以设它来绕过 Identity。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 2026-09 实测:DeepSeek 的 /models 只列出 deepseek-flash 和 deepseek-v4-pro。
# 旧名字 deepseek-chat / deepseek-reasoner 仍能用,但只是指向 flash 的别名。
# 这里填真实 ID,不依赖别名今后是否保留。
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_REASONER_MODEL=deepseek-v4-pro

# ---- IdP 演示账号 ----
# 密码/密钥留空则 seed_auth.py 自动生成强随机值并打印一次,自己存好。
DEMO_USERNAME=demo-user
DEMO_PASSWORD=
DEMO_CLIENT_ID=agentcore-cn-client
DEMO_CLIENT_SECRET=

# ---- Gateway 出向(机器到机器)----
# seed_auth.py 会建一个 <DEMO_CLIENT_ID>-m2m 的 client_credentials 客户端,
# 并打印它的 secret。把 secret 填到这里,然后跑 ./scripts/deploy.sh --identity,
# 它会被写进 AgentCore Identity 的 OAuth2 Credential Provider。
GATEWAY_CLIENT_ID=agentcore-cn-client-m2m
GATEWAY_CLIENT_SECRET=

# ---- Identity provider 名(留空用默认值 <PROJECT>-xxx)----
# DEEPSEEK_API_KEY_PROVIDER=agentcore-cn-deepseek
# GATEWAY_OAUTH_PROVIDER=agentcore-cn-gateway-oauth

# ---- Runtime 运行时配置(由部署脚本产出,填回来给 Runtime)----
# GATEWAY_URL=https://xxx.gateway.bedrock-agentcore.cn-northwest-1.amazonaws.com.cn/mcp
# ARTIFACT_BUCKET=agentcore-cn-artifacts-<account>

# ---- 本地调试 Gateway 时的绕行开关 ----
# 设了这三个就直连自建 IdP 换 token,不走 AgentCore Identity。
# IDP_TOKEN_ENDPOINT=https://xxx.execute-api.cn-northwest-1.amazonaws.com.cn/oauth2/token
